    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "nodemailer": "^10.1.0",
    "multer": "^2.0.2",
    "cloudinary": "^2.7.0",
    "sharp": "^0.35.5",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.15.0",
