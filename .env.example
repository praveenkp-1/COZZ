# Copy to .env at the workspace root. Never commit .env.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://cozzy:change-this-local-password@127.0.0.1:55432/cozzy
TRUST_PROXY=0
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Explicitly opts in to sample stock for local exploration only.
DEMO_INVENTORY=false
# Set a unique address/password before running npm run admin:create.
ADMIN_EMAIL=
ADMIN_PASSWORD=
