NODE_ENV=production
PORT=4000
APP_ORIGIN=https://shop.example.com
PUBLIC_API_ORIGIN=https://shop.example.com
# Use the managed database's TLS connection string from its secret store.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/cozzy?sslmode=verify-full
# Exactly one trusted reverse proxy; keep the application port private.
TRUST_PROXY=1
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DEMO_INVENTORY=false
